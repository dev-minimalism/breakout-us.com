# DB 연결 방식: true = SSH 터널 경유 (로컬 개발), false = 직접 연결 (서버)
USE_SSH_TUNNEL=true

# SSH Tunnel Settings
SSH_HOST=your_ssh_host
SSH_PORT=22
SSH_USER=your_ssh_user
SSH_KEY_PATH=~/.ssh/id_rsa

# PostgreSQL Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password

DYNAMIC_WATCHLIST_PATH=./watchlist.json

# Background Scanner Settings
SCANNER_ENABLED=true
SCAN_INTERVAL_SECONDS=1800
SCAN_DELAY_PER_STOCK=0.3

# Dynamic Screening Schedule (KST)
SCREENING_HOUR=23
SCREENING_MINUTE=30

# Paper Trading Settings (비율은 소수로: 0.20 = 20%)
INITIAL_CAPITAL=100000
POSITION_SIZE_PCT=0.20
MAX_POSITIONS=5
STOP_LOSS_PCT=0.08
TAKE_PROFIT_PCT=0.20
MAX_HOLDING_DAYS=30
ALERT_COOLDOWN_DAYS=7

# Breakout Detection
MIN_VOLUME_SURGE=50.0
MAX_BREAKOUT_PCT=5.0
